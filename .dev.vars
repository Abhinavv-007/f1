# Cloudflare Wrangler local dev secrets.
# Read by `wrangler dev` and `wrangler pages dev`.
# In production: `wrangler secret put NAME` or the Cloudflare dashboard.
#
# Real values never live in git. Drop your token in here locally,
# or run `wrangler secret put CLOUDFLARE_API_TOKEN` for the deployed worker.

# Master secret for /api/admin/* routes (sent in X-Admin-Secret header)
TRGT_ADMIN_SECRET=trgt-paddock-pass-2026

# Cloudflare API token used by /admin Vault tab and /api/admin/cloudflare.
# Needs at minimum: Account.Read, Workers.Read, D1.Read, KV.Read.
CLOUDFLARE_API_TOKEN=replace-with-your-cloudflare-user-token

# Optional: pin a specific account UUID to skip auto-detect.
# CLOUDFLARE_ACCOUNT_ID=
