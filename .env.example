# === TRGT environment template ===
# Copy to .env.local for next.js (`next dev`) or .dev.vars for wrangler.

# Master admin secret — sent in X-Admin-Secret header by /admin
TRGT_ADMIN_SECRET=replace-me

# Cloudflare API token (User Token) used by /admin Vault tab and
# /api/admin/cloudflare. Needs Account.Read, Workers.Read, D1.Read, KV.Read.
CLOUDFLARE_API_TOKEN=

# Optional: pin a specific Cloudflare account UUID to skip auto-detect.
CLOUDFLARE_ACCOUNT_ID=

# Firebase + Gemini (already used elsewhere)
NEXT_PUBLIC_FIREBASE_API_KEY=
GEMINI_API_KEY=
